# Server & Zero-Trust Enterprise Security Config
PORT=3000
NODE_ENV=development
DASHBOARD_SECRET_KEY=replace_with_64_char_cryptographic_hex_secret_for_production_mode
PUBLIC_HOST_URL=

# Universal AI Gateway & Auto-Failover Configuration
# Supported: gemini | openai | anthropic | openrouter | groq | deepseek | mistral | together | custom
AI_PROVIDER=gemini
AI_FAILOVER_CHAIN=gemini,groq,openrouter,openai

# Built-in Major Provider Keys
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# OpenRouter / Groq / DeepSeek / Universal OpenAI-Compatible Third-Party APIs
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-r1:free

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# Any Custom / Universal Third-Party LLM Endpoint
CUSTOM_AI_BASE_URL=https://api.openai.com/v1/chat/completions
CUSTOM_AI_API_KEY=your_custom_api_key_here
CUSTOM_AI_MODEL=gpt-4o-mini

# YouTube Data API v3 & Dynamic OAuth2 Config
YOUTUBE_CLIENT_ID=your_google_cloud_client_id
YOUTUBE_CLIENT_SECRET=your_google_cloud_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/oauth2callback

# MCP Hub & Enterprise Webhook / Telegram Alerts
MCP_ENABLED=true
ALLOW_BROWSER_MCP_CONNECT=true
WEBHOOK_NOTIFY_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# KineMaster-Style Media Studio & FFmpeg Process Guard Config
FFMPEG_PATH=ffmpeg
FFMPEG_TIMEOUT_MS=90000
VIDEO_OUTPUT_FPS=30
VIDEO_RESOLUTION=1920x1080
MAX_UPLOAD_SIZE_MB=150
