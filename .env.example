# Server & Zero-Trust Security Config
PORT=3000
NODE_ENV=development
# MUST be a strong 32+ char secret in production (auto-generated in dev if weak)
DASHBOARD_SECRET_KEY=replace_with_64_char_cryptographic_hex_secret_for_production_mode

# Optional Cloud Host URL (Auto-detected on GitHub Codespaces)
PUBLIC_HOST_URL=

# AI / LLM Provider Keys (Gemini / OpenAI / Anthropic)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# YouTube Data API v3 & Dynamic OAuth2 Config
YOUTUBE_CLIENT_ID=your_google_cloud_client_id
YOUTUBE_CLIENT_SECRET=your_google_cloud_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/oauth2callback

# MCP (Model Context Protocol) Hub Settings
MCP_ENABLED=true
ALLOW_BROWSER_MCP_CONNECT=true

# Code-Driven Video Editor (FFmpeg) & Process Guard Config
FFMPEG_PATH=ffmpeg
FFMPEG_TIMEOUT_MS=45000
VIDEO_OUTPUT_FPS=30
VIDEO_RESOLUTION=1920x1080
