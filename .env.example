# Server & Zero-Trust Authentication Config
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
# Required 32+ char secret for Bearer/Header Auth (Generated automatically by npm run setup)
DASHBOARD_SECRET_KEY=replace_with_64_char_cryptographic_hex_secret_for_production_mode
PUBLIC_HOST_URL=

# In-Process Scheduler Config (Runs inside npm start without DB split-brain)
ENABLE_SCHEDULER=true
SCHEDULER_CRON=0 9 * * *
SCHEDULER_TIMEZONE=Asia/Kolkata

# Universal AI Gateway & Auto-Failover Configuration
# Supported: gemini | openai | anthropic | openrouter | groq | deepseek | mistral | together | custom
AI_PROVIDER=gemini
AI_FAILOVER_CHAIN=gemini,groq,openrouter,openai,deepseek,mistral,together

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

CUSTOM_AI_BASE_URL=https://api.openai.com/v1/chat/completions
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=gpt-4o-mini

# Humanized Neural TTS (Text-to-Speech) Configuration
# Supported TTS_PROVIDER: edge-neural (Free Humanized Hindi/English) | elevenlabs | openai
TTS_PROVIDER=edge-neural
TTS_VOICE_HI=hi-IN-MadhurNeural
TTS_VOICE_EN=en-IN-PrabhatNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Optional Stock B-Roll Footage API (Fetches real HD clips instead of plain color slides)
PEXELS_API_KEY=

# YouTube Data API v3 & OAuth2 Config
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:3000/oauth2callback

# Webhook & Telegram Notifications
WEBHOOK_NOTIFY_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# FFmpeg, ffprobe & Devanagari Hindi Font Config
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FONT_FILE_PATH=
FFMPEG_TIMEOUT_MS=180000
VIDEO_OUTPUT_FPS=30
VIDEO_RESOLUTION=1920x1080
MAX_UPLOAD_SIZE_MB=150
