# Server & Dashboard Config
PORT=3000
NODE_ENV=development
DASHBOARD_SECRET_KEY=change_this_to_a_strong_random_key_32_chars

# AI / LLM Provider Keys (Gemini / OpenAI / Anthropic)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# YouTube Data API v3 & OAuth2 Config
YOUTUBE_CLIENT_ID=your_google_cloud_client_id
YOUTUBE_CLIENT_SECRET=your_google_cloud_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/oauth2callback

# MCP (Model Context Protocol) Hub Settings
MCP_ENABLED=true
MCP_PORT=3001
ALLOW_BROWSER_MCP_CONNECT=true

# Code-Driven Video Editor (FFmpeg) Config
FFMPEG_PATH=ffmpeg
VIDEO_OUTPUT_FPS=30
VIDEO_RESOLUTION=1920x1080
